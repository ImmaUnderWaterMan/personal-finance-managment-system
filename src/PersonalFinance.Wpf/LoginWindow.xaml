<Window
    x:Class="PersonalFinance.Wpf.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Вход"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Loaded="WindowLoaded"
    Closing="WindowClosing">
    <StackPanel
        Margin="32">
        <TextBlock
            Text="Мои финансы"
            FontSize="28"
            FontWeight="Bold"
            Margin="0,0,0,20" />
        <Label
            Content="Email"
            Target="{Binding ElementName=EmailBox}" />
        <TextBox
            x:Name="EmailBox"
            AutomationProperties.Name="Email" />
        <Label
            Content="Пароль"
            Target="{Binding ElementName=PasswordBox}" />
        <PasswordBox
            x:Name="PasswordBox"
            Padding="10"
            AutomationProperties.Name="Пароль" />
        <TextBlock
            x:Name="ErrorLabel"
            TextWrapping="Wrap"
            Foreground="Firebrick"
            Margin="0,12,0,12"
            AutomationProperties.LiveSetting="Polite" />
        <Button
            x:Name="LoginButton"
            Content="Войти"
            IsDefault="True"
            Margin="0,8,0,8"
            Click="LoginClick" />
        <Button
            x:Name="RegisterButton"
            Content="Создать аккаунт"
            Click="OpenRegistration" />
    </StackPanel>
</Window>
