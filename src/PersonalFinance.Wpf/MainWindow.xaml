<Window x:Class="PersonalFinance.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Personal Finance — Личные финансы" Width="1280" Height="850" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142F38" Padding="20,30">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,38">
     <TextBlock Text="PF /" Foreground="#73CDB9" FontSize="28" FontWeight="Bold"/>
     <TextBlock Text="personal finance" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
     <TextBlock Text="Ваши деньги. Ваши планы." Foreground="#93ACB5" FontSize="11" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border BorderBrush="#36515A" BorderThickness="0,1,0,0" Padding="7,20,0,0">
      <StackPanel><TextBlock Text="Учебный проект" Foreground="#D4E2E6"/><TextBlock Text="Демонстрационные данные" Foreground="#8AA5AF" FontSize="11" Margin="0,7,0,0"/></StackPanel>
     </Border>
    </StackPanel>
    <StackPanel>
     <Button x:Name="OverviewNav" Content="Обзор" Tag="Обзор" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button x:Name="AccountsNav" Content="Счета" Tag="Счета" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button x:Name="TransactionsNav" Content="Операции" Tag="Операции" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button x:Name="BudgetsNav" Content="Бюджеты" Tag="Бюджеты" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button x:Name="ReportsNav" Content="Отчёты" Tag="Отчёты" Style="{StaticResource Nav}" Click="Navigate"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,28,32,24">
    <Grid Margin="0,0,0,24">
     <StackPanel><TextBlock Text="ЛИЧНЫЕ ФИНАНСЫ" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="Обзор" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="PeriodLabel" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
     <Button Content="+  Добавить операцию" Click="AddTransaction" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Border Background="#E5F1ED" CornerRadius="8" Padding="14,10" Margin="0,0,0,22"><TextBlock Text="Демо-режим · Изменения хранятся до закрытия приложения. Подключение к API будет добавлено позже." Foreground="#35695F" FontSize="12" TextWrapping="Wrap"/></Border>
    <UniformGrid x:Name="SummaryPanel" Columns="3" Margin="0,0,0,22">
     <Border Style="{StaticResource Card}" Background="#177F72" Margin="0,0,12,0"><StackPanel><TextBlock Text="Общий баланс" Foreground="#CDE8E0"/><TextBlock x:Name="BalanceLabel" Foreground="White" FontSize="29" FontWeight="SemiBold" Margin="0,12,0,10"/><TextBlock Text="По всем активным счетам" Foreground="#CDE8E0" FontSize="11"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Доходы за месяц" Foreground="{StaticResource Muted}"/><TextBlock x:Name="IncomeLabel" FontSize="29" FontWeight="SemiBold" Margin="0,12,0,10"/><TextBlock Text="Все поступления за текущий месяц" Style="{StaticResource Caption}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Расходы за месяц" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ExpenseLabel" FontSize="29" FontWeight="SemiBold" Margin="0,12,0,10"/><TextBlock Text="Все расходы за текущий месяц" Style="{StaticResource Caption}"/></StackPanel></Border>
    </UniformGrid>
    <Border x:Name="AccountsPanel" Style="{StaticResource Card}" Margin="0,0,0,22">
     <StackPanel><TextBlock Text="Мои счета" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <ItemsControl x:Name="AccountsList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E4EAED" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding BalanceText}" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock Text="Активный счёт · RUB" Style="{StaticResource Caption}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Border>
    <Border x:Name="OperationsPanel" Style="{StaticResource Card}" Margin="0,0,0,22">
     <StackPanel>
      <Grid Margin="0,0,0,14"><TextBlock Text="Операции" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Width="240" HorizontalAlignment="Right" ToolTip="Поиск по описанию, категории или счёту" AutomationProperties.Name="Поиск операций" TextChanged="SearchChanged"/></Grid>
      <TextBlock Text="Поиск по описанию, категории или счёту" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
      <DataGrid x:Name="OperationsGrid" MaxHeight="360" MinHeight="120" AutomationProperties.Name="Список операций">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="95"/>
        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="130"/>
        <DataGridTextColumn Header="Счёт" Binding="{Binding Account}" Width="125"/>
        <DataGridTextColumn Header="Сумма" Binding="{Binding AmountText}" Width="130"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyLabel" Text="Операции не найдены. Измените запрос или добавьте операцию." Foreground="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed"/>
     </StackPanel>
    </Border>
    <Border x:Name="BudgetsPanel" Style="{StaticResource Card}" Margin="0,0,0,22"><StackPanel><TextBlock Text="Бюджеты на месяц" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/><ItemsControl x:Name="BudgetList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,18"><Grid><TextBlock Text="{Binding Category}"/><TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid><ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="7" Margin="0,10,0,6" Maximum="100" Foreground="{Binding BarColor}" Background="#EBF0F2" BorderThickness="0"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding BarColor}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <Border x:Name="ReportsPanel" Style="{StaticResource Card}" Margin="0,0,0,22" Visibility="Collapsed"><StackPanel><TextBlock Text="Расходы по категориям" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/><ItemsControl x:Name="ReportList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,14"><TextBlock Text="{Binding Category}"/><TextBlock Text="{Binding AmountText}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="ReportTotal" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    <TextBlock x:Name="StatusLabel" Text="Данные для знакомства с интерфейсом" Style="{StaticResource Caption}"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
