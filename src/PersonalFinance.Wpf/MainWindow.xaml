<Window
    x:Class="PersonalFinance.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PersonalFinance.Wpf"
    Title="Personal Finance"
    Width="1320"
    Height="900"
    MinWidth="1100"
    MinHeight="720"
    WindowStartupLocation="CenterScreen">
    <Border
        Margin="16"
        CornerRadius="22"
        Background="#BFCBED"
        BorderBrush="#9BABD3"
        BorderThickness="2"
        Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="190" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Padding="15,24,20,16">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Top"
                        Margin="8,0,0,40">
                        <TextBlock
                            Text="PERSONAL FINANCE"
                            FontSize="14"
                            FontWeight="Black" />
                    </StackPanel>
                    <Border
                        DockPanel.Dock="Bottom"
                        Background="#CCD5EF"
                        CornerRadius="12"
                        Padding="14">
                        <StackPanel>
                            <TextBlock
                                Text="Личный кабинет"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Мои финансы"
                                Foreground="#596483"
                                FontSize="12"
                                Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <Button
                            x:Name="OverviewNav"
                            Content="Обзор"
                            Tag="Обзор"
                            Style="{StaticResource Nav}"
                            Click="Navigate" />
                        <Button
                            x:Name="AccountsNav"
                            Content="Счета"
                            Tag="Счета"
                            Style="{StaticResource Nav}"
                            Click="Navigate" />
                        <Button
                            x:Name="TransactionsNav"
                            Content="Операции"
                            Tag="Операции"
                            Style="{StaticResource Nav}"
                            Click="Navigate" />
                        <Button
                            x:Name="BudgetsNav"
                            Content="Бюджеты"
                            Tag="Бюджеты"
                            Style="{StaticResource Nav}"
                            Click="Navigate" />
                        <Button
                            x:Name="ReportsNav"
                            Content="Отчёты"
                            Tag="Отчёты"
                            Style="{StaticResource Nav}"
                            Click="Navigate" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border
                Grid.Column="1"
                Background="#F8F9FF"
                CornerRadius="17">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel
                        Margin="28,24,28,20">
                        <Grid
                            Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock
                                    Text="МОИ ДЕНЬГИ"
                                    FontSize="10"
                                    Foreground="{StaticResource Muted}"
                                    FontWeight="Bold" />
                                <TextBlock
                                    x:Name="PageTitle"
                                    Text="Обзор"
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Margin="0,5,0,0" />
                                <TextBlock
                                    x:Name="PeriodLabel"
                                    Foreground="{StaticResource Muted}"
                                    Margin="0,6,0,0" />
                            </StackPanel>
                            <Button
                                Content="+  Добавить операцию"
                                Click="AddTransaction"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                        </Grid>
                        <WrapPanel
                            Margin="0,0,0,18">
                            <Button
                                Content="+ Счёт"
                                Click="AddAccount"
                                Margin="0,0,8,6" />
                            <Button
                                Content="+ Категория"
                                Click="AddCategory"
                                Margin="0,0,8,6" />
                            <Button
                                Content="Бюджет"
                                Click="SetBudget"
                                Margin="0,0,8,6" />
                            <Button
                                Content="Обновить"
                                Click="RefreshData"
                                Margin="0,0,8,6" />
                        </WrapPanel>
                        <Border
                            x:Name="ReportPeriodPanel"
                            Style="{StaticResource Card}"
                            Margin="0,0,0,20"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock
                                    Text="Период отчёта"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,12" />
                                <WrapPanel
                                    x:Name="ReportPeriodControls"
                                    Language="ru-RU">
                                    <StackPanel
                                        Margin="0,0,16,8">
                                        <Label
                                            Content="С"
                                            Target="{Binding ElementName=ReportFromDate}" />
                                        <DatePicker
                                            x:Name="ReportFromDate"
                                            Width="160"
                                            Padding="8"
                                            SelectedDateFormat="Short"
                                            AutomationProperties.Name="Начало периода отчёта" />
                                    </StackPanel>
                                    <StackPanel
                                        Margin="0,0,16,8">
                                        <Label
                                            Content="По"
                                            Target="{Binding ElementName=ReportToDate}" />
                                        <DatePicker
                                            x:Name="ReportToDate"
                                            Width="160"
                                            Padding="8"
                                            SelectedDateFormat="Short"
                                            AutomationProperties.Name="Окончание периода отчёта включительно" />
                                    </StackPanel>
                                    <Button
                                        x:Name="ShowReportButton"
                                        Content="Показать"
                                        Click="ApplyReportPeriod"
                                        MinWidth="110"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,8" />
                                </WrapPanel>
                                <TextBlock
                                    x:Name="ReportPeriodError"
                                    Foreground="Firebrick"
                                    TextWrapping="Wrap"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <UniformGrid
                            x:Name="SummaryPanel"
                            Columns="3"
                            Margin="0,0,0,20">
                            <Border
                                Style="{StaticResource Card}"
                                Background="#E6E1FF"
                                Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="BalanceTitle"
                                        Text="Общий баланс"
                                        TextWrapping="Wrap"
                                        Foreground="#60568F" />
                                    <TextBlock
                                        x:Name="BalanceLabel"
                                        FontSize="29"
                                        FontWeight="Bold"
                                        Margin="0,12,0,10" />
                                    <TextBlock
                                        Text="Все счета · RUB"
                                        Foreground="#75699F"
                                        FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border
                                Style="{StaticResource Card}"
                                Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="IncomeTitle"
                                        Text="Доходы за месяц"
                                        Foreground="{StaticResource Muted}" />
                                    <TextBlock
                                        x:Name="IncomeLabel"
                                        FontSize="29"
                                        FontWeight="Bold"
                                        Margin="0,12,0,10" />
                                    <TextBlock
                                        Text="Поступления на ваши счета"
                                        Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="ExpenseTitle"
                                        Text="Расходы за месяц"
                                        Foreground="{StaticResource Muted}" />
                                    <TextBlock
                                        x:Name="ExpenseLabel"
                                        FontSize="29"
                                        FontWeight="Bold"
                                        Margin="0,12,0,10" />
                                    <TextBlock
                                        Text="Расходы по всем категориям"
                                        Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Grid
                            x:Name="InsightsPanel"
                            Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Style="{StaticResource Card}"
                                Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock
                                        Text="Финансовый ритм"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Margin="0,0,0,16" />
                                    <UniformGrid
                                        x:Name="RhythmIndicators"
                                        Columns="2">
                                        <StackPanel>
                                            <local:RingGauge
                                                x:Name="SavingsGauge"
                                                Width="124"
                                                Height="124"
                                                ToolTip="Доля доходов, оставшаяся после расходов" />
                                            <TextBlock
                                                Text="Сохранено от дохода"
                                                FontSize="11"
                                                Foreground="#716A8A"
                                                HorizontalAlignment="Center"
                                                Margin="0,9,0,0" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="BudgetIndicator">
                                            <local:RingGauge
                                                x:Name="BudgetGauge"
                                                Width="124"
                                                Height="124"
                                                ToolTip="Доля израсходованной суммы в категориях с бюджетом" />
                                            <TextBlock
                                                Text="Бюджет использован"
                                                FontSize="11"
                                                Foreground="#716A8A"
                                                HorizontalAlignment="Center"
                                                Margin="0,9,0,0" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock
                                        Text="Расходы по категориям"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Margin="0,0,0,14" />
                                    <ItemsControl
                                        x:Name="ChartList"
                                        Height="170">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid
                                                    Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Margin="5,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition
                                                            Height="*" />
                                                        <RowDefinition
                                                            Height="24" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel
                                                        VerticalAlignment="Bottom">
                                                        <TextBlock
                                                            Text="{Binding AmountText}"
                                                            FontSize="10"
                                                            HorizontalAlignment="Center"
                                                            Foreground="#6E6887"
                                                            Margin="0,0,0,6" />
                                                        <Border
                                                            Height="{Binding Height}"
                                                            Background="{Binding Color}"
                                                            Width="34"
                                                            CornerRadius="5,5,0,0"
                                                            HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Text="{Binding Category}"
                                                        FontSize="10"
                                                        Foreground="#6E6887"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Bottom" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border
                            x:Name="AccountsPanel"
                            Style="{StaticResource Card}"
                            Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock
                                    Text="Мои счета"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,16" />
                                <ItemsControl
                                    x:Name="AccountsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid
                                                Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="#F0F1FC"
                                                CornerRadius="10"
                                                Padding="15"
                                                Margin="0,0,10,10">
                                                <StackPanel>
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        TextWrapping="Wrap"
                                                        Foreground="{StaticResource Muted}" />
                                                    <TextBlock
                                                        Text="{Binding BalanceText}"
                                                        FontSize="22"
                                                        FontWeight="Bold"
                                                        Margin="0,10,0,6" />
                                                    <TextBlock
                                                        Text="{Binding StateText}"
                                                        Style="{StaticResource Caption}" />
                                                    <WrapPanel
                                                        Margin="0,14,0,0">
                                                        <Button
                                                            Content="Переименовать"
                                                            Tag="{Binding AccountId}"
                                                            Click="RenameAccount"
                                                            FontSize="12"
                                                            Padding="10,7"
                                                            Margin="0,0,6,4" />
                                                        <Button
                                                            Content="В архив"
                                                            Tag="{Binding AccountId}"
                                                            Click="ArchiveAccount"
                                                            IsEnabled="{Binding CanArchive}"
                                                            FontSize="12"
                                                            Padding="10,7"
                                                            Background="#E3E2F6"
                                                            Foreground="{StaticResource Ink}"
                                                            Margin="0,0,0,4" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="OperationsPanel"
                            Style="{StaticResource Card}"
                            Margin="0,0,0,20">
                            <StackPanel>
                                <Grid
                                    Margin="0,0,0,14">
                                    <TextBlock
                                        x:Name="OperationsTitle"
                                        Text="Последние операции"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        x:Name="SearchBox"
                                        Width="230"
                                        HorizontalAlignment="Right"
                                        ToolTip="Поиск по описанию, категории или счёту"
                                        AutomationProperties.Name="Поиск операций"
                                        TextChanged="SearchChanged" />
                                </Grid>
                                <TextBlock
                                    Text="Поиск по описанию, категории или счёту"
                                    Style="{StaticResource Caption}"
                                    Margin="0,0,0,12" />
                                <StackPanel
                                    x:Name="HistoryPeriodPanel"
                                    Margin="0,0,0,16"
                                    Visibility="Collapsed">
                                    <WrapPanel
                                        x:Name="HistoryPeriodControls"
                                        Language="ru-RU">
                                        <StackPanel
                                            Margin="0,0,16,8">
                                            <Label
                                                Content="С"
                                                Target="{Binding ElementName=HistoryFromDate}" />
                                            <DatePicker
                                                x:Name="HistoryFromDate"
                                                Width="160"
                                                Padding="8"
                                                SelectedDateFormat="Short"
                                                AutomationProperties.Name="Начало периода истории операций" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="0,0,16,8">
                                            <Label
                                                Content="По"
                                                Target="{Binding ElementName=HistoryToDate}" />
                                            <DatePicker
                                                x:Name="HistoryToDate"
                                                Width="160"
                                                Padding="8"
                                                SelectedDateFormat="Short"
                                                AutomationProperties.Name="Окончание периода истории включительно" />
                                        </StackPanel>
                                        <Button
                                            x:Name="ShowHistoryButton"
                                            Content="Показать"
                                            Click="ApplyHistoryPeriod"
                                            MinWidth="110"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,8,8" />
                                        <Button
                                            x:Name="ResetHistoryButton"
                                            Content="Сбросить"
                                            Click="ResetHistoryPeriod"
                                            ToolTip="Очистить фильтр по датам"
                                            Background="#E3E2F6"
                                            Foreground="{StaticResource Ink}"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <TextBlock
                                        x:Name="HistoryPeriodError"
                                        Foreground="Firebrick"
                                        TextWrapping="Wrap"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <DataGrid
                                    x:Name="OperationsGrid"
                                    MaxHeight="360"
                                    MinHeight="120"
                                    AutomationProperties.Name="Список операций">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Header="Дата"
                                            Binding="{Binding DateText}"
                                            Width="95" />
                                        <DataGridTextColumn
                                            Header="Описание"
                                            Binding="{Binding Description}"
                                            Width="*" />
                                        <DataGridTextColumn
                                            Header="Категория"
                                            Binding="{Binding Category}"
                                            Width="115" />
                                        <DataGridTextColumn
                                            Header="Счёт"
                                            Binding="{Binding Account}"
                                            Width="120" />
                                        <DataGridTextColumn
                                            Header="Сумма"
                                            Binding="{Binding AmountText}"
                                            Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock
                                    x:Name="EmptyLabel"
                                    Text="Операции не найдены. Измените период или поисковый запрос."
                                    Foreground="{StaticResource Muted}"
                                    Margin="0,12,0,0"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="BudgetsPanel"
                            Style="{StaticResource Card}"
                            Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock
                                    x:Name="BudgetTitle"
                                    Text="Бюджеты"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,18" />
                                <StackPanel
                                    x:Name="BudgetPeriodPanel"
                                    Margin="0,0,0,18"
                                    Visibility="Collapsed">
                                    <WrapPanel
                                        x:Name="BudgetPeriodControls">
                                        <StackPanel
                                            Margin="0,0,16,8">
                                            <Label
                                                Content="Месяц"
                                                Target="{Binding ElementName=BudgetMonthBox}" />
                                            <ComboBox
                                                x:Name="BudgetMonthBox"
                                                Width="170"
                                                DisplayMemberPath="Name"
                                                SelectedValuePath="Value"
                                                AutomationProperties.Name="Месяц бюджета" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="0,0,16,8">
                                            <Label
                                                Content="Год"
                                                Target="{Binding ElementName=BudgetYearBox}" />
                                            <TextBox
                                                x:Name="BudgetYearBox"
                                                Width="100"
                                                MaxLength="4"
                                                AutomationProperties.Name="Год бюджета" />
                                        </StackPanel>
                                        <Button
                                            x:Name="ShowBudgetButton"
                                            Content="Показать"
                                            Click="ApplyBudgetPeriod"
                                            MinWidth="110"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <TextBlock
                                        x:Name="BudgetPeriodError"
                                        Foreground="Firebrick"
                                        TextWrapping="Wrap"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <ItemsControl
                                    x:Name="BudgetList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Margin="0,0,0,18">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="{Binding Category}"
                                                        TextWrapping="Wrap"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding Summary}"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource Muted}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Content="Изменить"
                                                        Tag="{Binding Budget}"
                                                        Click="EditBudget"
                                                        FontSize="12"
                                                        Padding="10,6"
                                                        Margin="12,0,0,0" />
                                                </Grid>
                                                <ProgressBar
                                                    Value="{Binding Percent, Mode=OneWay}"
                                                    Height="7"
                                                    Margin="0,10,0,6"
                                                    Maximum="100"
                                                    Foreground="{Binding BarColor}"
                                                    Background="#E8E9F6"
                                                    BorderThickness="0" />
                                                <TextBlock
                                                    Text="{Binding Status}"
                                                    FontSize="11"
                                                    Foreground="{Binding BarColor}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="BudgetEmptyLabel"
                                    Text="На этот месяц бюджеты ещё не установлены."
                                    Foreground="{StaticResource Muted}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="ReportsPanel"
                            Style="{StaticResource Card}"
                            Margin="0,0,0,20"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock
                                    Text="Сводка за период"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,18" />
                                <ItemsControl
                                    x:Name="ReportList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="0,0,0,14">
                                                <TextBlock
                                                    Text="{Binding Category}" />
                                                <TextBlock
                                                    Text="{Binding AmountText}"
                                                    HorizontalAlignment="Right"
                                                    FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="ReportEmptyLabel"
                                    Text="За выбранный период расходов нет."
                                    Foreground="{StaticResource Muted}"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="ReportTotal"
                                    Foreground="{StaticResource Muted}"
                                    Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
